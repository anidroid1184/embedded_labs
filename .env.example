# Copy to .env and adjust. Never commit .env.
# Local-only defaults — replace before any shared/deployed environment.

POSTGRES_USER=embedded
POSTGRES_PASSWORD=changeme
POSTGRES_DB=embedded_labs

# Host port for compose Postgres is 15433. Inside Docker use host `postgres:5432`.
DATABASE_URL=postgres://embedded:changeme@localhost:15433/embedded_labs

API_HOST=0.0.0.0
API_PORT=8080
RUST_LOG=info,embedded_labs_api=debug
CONTENT_DIR=/content/lessons
CORS_ORIGIN=http://localhost:5173
